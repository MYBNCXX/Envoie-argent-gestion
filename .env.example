# URL et clé "service role" de votre projet Supabase
# (Project Settings → API dans le tableau de bord Supabase)
# La clé service role reste STRICTEMENT côté serveur : ne jamais la préfixer
# par NEXT_PUBLIC_ ni l'exposer au client.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
